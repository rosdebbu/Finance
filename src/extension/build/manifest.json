{
  "manifest_version": 3,
  "name": "CommitGuard - Embedded Pre-Commitment Interceptor",
  "version": "1.0.0",
  "description": "Embedded financial pre-commitment interceptor for checkout and banking flows. Halts high-friction No-Cost EMI and lock-in traps in <2ms with deterministic math clarity.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.flipkart.com/*",
    "*://*.makemytrip.com/*",
    "*://*.udemy.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.flipkart.com/*",
        "*://*.makemytrip.com/*",
        "*://*.udemy.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CommitGuard Active (Monitoring Checkouts)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css"
      ],
      "matches": [
        "*://*.amazon.in/*",
        "*://*.flipkart.com/*",
        "*://*.makemytrip.com/*",
        "*://*.udemy.com/*"
      ]
    }
  ]
}