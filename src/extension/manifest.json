{
  "manifest_version": 3,
  "name": "CommitGuard - Embedded Pre-Commitment Interceptor",
  "version": "1.0.0",
  "description": "Embedded financial pre-commitment interceptor for checkout and banking flows. Halts high-friction No-Cost EMI and lock-in traps in <2ms with deterministic math clarity.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "*://*.amazon.in/*",
    "*://*.flipkart.com/*",
    "*://*.makemytrip.com/*",
    "*://*.udemy.com/*"
  ],
  "background": {
    "service_worker": "src/extension/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.in/*",
        "*://*.flipkart.com/*",
        "*://*.makemytrip.com/*",
        "*://*.udemy.com/*"
      ],
      "js": ["src/extension/content.tsx"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CommitGuard Active (Monitoring Checkouts)"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/extension/styles.css"
      ],
      "matches": [
        "*://*.amazon.in/*",
        "*://*.flipkart.com/*",
        "*://*.makemytrip.com/*",
        "*://*.udemy.com/*"
      ]
    }
  ]
}
